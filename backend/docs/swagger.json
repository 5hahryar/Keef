            "x-enum-varnames": [
                "InstallmentPending",
                "InstallmentPaid",
                "InstallmentOverdue"
            ]
        },
        "models.Loan": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "installmentAmount": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "numberOfDueDay": {
                    "type": "integer"
                },
                "numberOfInstallments": {
                    "type": "integer"
                }
            }
        },
        "models.LoanDetail": {
